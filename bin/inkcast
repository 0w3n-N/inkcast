#!/usr/bin/env python3
import os
import sys

# Never write __pycache__ into the plugin folder: Omarchy hot-reloads a plugin
# whenever a file in its folder changes.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from inkcast.cli import main  # noqa: E402

main()
