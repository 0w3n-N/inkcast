{
  "schemaVersion": 1,
  "id": "io.github.0w3n-n.inkcast",
  "name": "Inkcast",
  "version": "0.3.0",
  "author": "0w3n-N",
  "license": "MIT",
  "description": "Use an iPad and Apple Pencil as a drawing tablet: write on paper, PDFs or a live view of any desktop window, and share it in a window. Optional AirPlay mirroring. Local network only.",
  "homepage": "https://github.com/0w3n-N/inkcast",
  "repository": "https://github.com/0w3n-N/inkcast",
  "keywords": [
    "ipad",
    "apple pencil",
    "whiteboard",
    "annotate",
    "airplay",
    "screen share",
    "education"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Inkcast",
    "description": "Start Inkcast, pair the iPad by QR code, open the share window, annotate a desktop window, and toggle AirPlay mirroring.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 8770,
      "airplayName": "Omarchy",
      "airplayAudio": "on"
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "Whiteboard port",
        "min": 1024,
        "max": 65535,
        "step": 1,
        "defaultValue": 8770
      },
      {
        "key": "airplayName",
        "type": "string",
        "label": "AirPlay name shown on the iPad",
        "defaultValue": "Omarchy"
      },
      {
        "key": "airplayAudio",
        "type": "enum",
        "label": "Play iPad audio while mirroring",
        "options": [
          {
            "value": "on",
            "label": "On"
          },
          {
            "value": "off",
            "label": "Off"
          }
        ],
        "defaultValue": "on"
      }
    ]
  }
}
